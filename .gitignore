# Investigation directory for other anticheats
proton-anticheats*/

# Latex PDF output directory
build/
# Generated by Cargo
# will have compiled files and executables
debug
target

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
# Contains mutation testing data
**/mutants.out*/

# Quark testing signing key -- generated by tooling/keys/generate-testing-key.sh,
# never committed. The matching public key is committed as kernel/quark_pubkey.h.
tooling/keys/quark_signing_key.pem
tooling/keys/quark_signing_key_pub.der

# Auto-generated at build time from the compiled quark_cli binary (see Makefile) --
# regenerated on every build, not meant to be tracked.
kernel/quark_cli_hash.h

# RustRover
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
#.idea/

cheat/cheat
quark_daemon/quark_cli
game_target/game

# Compilation database
compile_commands.json

# Linux kernel build artifacts
kernel/.*
kernel/*.ko
kernel/*.o
kernel/*.mod
kernel/*.mod.c
kernel/Module.symvers
kernel/modules.order

# SDK shared library (`make sdk`)
sdk/libquark_sdk.so*

# Arch packaging build output (packaging/arch/build-packages.sh, publish-repo.sh)
packaging/arch/src/
packaging/arch/pkg/
packaging/arch/out/
packaging/arch/*.tar.gz
*.pkg.tar.zst
*.pkg.tar.zst.sig

# Generated from the build host's kernel BTF (`make vmlinux`), consumed by
# quark_daemon/src/bpf/quark.bpf.c -- ~160k lines, host-specific, not tracked.
quark_daemon/src/bpf/vmlinux.h
