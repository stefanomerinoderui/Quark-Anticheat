[Unit]
Description=Quark Anticheat Daemon Socket

[Socket]
ListenStream=/run/quark/quark.sock
# systemd creates /run/quark itself (root-owned, DirectoryMode= default 0755),
# so only root can place a socket there -- see sdk/quark_sdk.c.
# rw for all: the daemon runs as root (see quark.service), but game
# processes connecting to it run as a regular user and need to reach this
# socket. Matches the SDK's hardcoded path in sdk/quark_sdk.c.
SocketMode=0666
RemoveOnStop=true

[Install]
WantedBy=sockets.target
