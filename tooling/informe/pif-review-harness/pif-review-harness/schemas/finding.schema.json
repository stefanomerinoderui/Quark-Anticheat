{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Hallazgo",
  "type": "object",
  "required": [
    "item_id",
    "clave",
    "semaforo",
    "norma",
    "ubicaciones",
    "observacion",
    "destino",
    "origen"
  ],
  "properties": {
    "item_id": {
      "type": "string"
    },
    "clave": {
      "type": "string",
      "pattern": "^[A-Z]+-[0-9]{2}:[a-z0-9_\\-]+$",
      "description": "Identificador estable del problema para seguir reincidencia"
    },
    "semaforo": {
      "enum": [
        "ROJO",
        "AMARILLO",
        "VERDE",
        "GRIS"
      ]
    },
    "bloqueante": {
      "type": "boolean"
    },
    "norma": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "fuente",
          "ref"
        ],
        "properties": {
          "fuente": {
            "enum": [
              "RR97",
              "RR258",
              "PLAN26",
              "AE26",
              "PROG",
              "CAT",
              "LEY"
            ]
          },
          "ref": {
            "type": "string"
          },
          "verificado": {
            "type": "boolean"
          }
        }
      }
    },
    "ubicaciones": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "tipo"
        ],
        "properties": {
          "tipo": {
            "enum": [
              "pdf",
              "repo",
              "artifact",
              "web"
            ]
          },
          "pdf_page": {
            "type": "integer",
            "minimum": 1,
            "description": "Página del PDF (1 = primera hoja)"
          },
          "printed_page": {
            "type": [
              "string",
              "null"
            ]
          },
          "path": {
            "type": "string",
            "description": "Ruta relativa dentro de input/repo_codigo o input/repo_docs"
          },
          "line": {
            "type": "integer",
            "minimum": 1
          },
          "artifact": {
            "type": "string",
            "description": "p. ej. pdf_format.json#margins"
          },
          "url": {
            "type": "string"
          },
          "consulta": {
            "type": "string"
          },
          "fecha": {
            "type": "string"
          },
          "cita_literal": {
            "type": "string",
            "description": "Texto copiado tal cual; obligatorio para pdf y repo"
          }
        }
      }
    },
    "observacion": {
      "type": "string"
    },
    "que_se_espera": {
      "type": "string"
    },
    "evidencia_a_presentar": {
      "type": "string"
    },
    "motivo_gris": {
      "type": "string"
    },
    "destino": {
      "enum": [
        "devolucion",
        "informe_docente",
        "ambos"
      ]
    },
    "pregunta_coloquio": {
      "type": "string"
    },
    "origen": {
      "enum": [
        "script",
        "maker"
      ]
    },
    "verificacion_mecanica": {
      "type": "object"
    },
    "checker": {
      "type": "object"
    },
    "obs_id": {
      "type": "string"
    }
  }
}